# =============================================================================
# VARIABLES DE ENTORNO
# =============================================================================
# Copia este archivo a `.env` para desarrollo local. En producción se definen
# en la consola de Amplify (App settings › Environment variables).
#
# El prefijo PUBLIC_ es obligatorio: es lo que hace que Astro las exponga al
# navegador. No pongas secretos aquí; acaban en el HTML público.
# =============================================================================

# Id del sitio en Umami (Settings › Websites). Si está vacío no se carga el
# script de analítica, que es justo lo que quieres en local.
PUBLIC_UMAMI_WEBSITE_ID=

# Opcional. Solo si sirves el script desde tu dominio para esquivar
# bloqueadores. Por defecto: https://cloud.umami.is/script.js
# PUBLIC_UMAMI_SRC=https://geduardo.com/stats/script.js
